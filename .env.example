# ============================================================
# LUMEN Photography Suite — Environment Configuration Example
# Copy this file to '.env' and update with your local credentials.
# Never commit real passwords or private keys to git or submissions.
# ============================================================

# Database Configuration (provide DATABASE_URL or the DB_* variables)
# DATABASE_URL="mysql://lumen_user:replace_with_local_password@localhost:3306/lumen_db"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="lumen_user"
DB_PASSWORD="replace_with_local_password"
DB_NAME="lumen_db"

# Authentication Configuration
# Use a stable random secret of at least 32 characters; keep it private.
AUTH_TOKEN_SECRET="replace_with_a_random_32_character_or_longer_secret"

# Server Configuration
PORT="3000"
NODE_ENV="development"
UPLOAD_DIR="./uploads"
UPLOAD_STORAGE="local"


# APP_URL: Public app address for production deployments
APP_URL="http://localhost:3000"
